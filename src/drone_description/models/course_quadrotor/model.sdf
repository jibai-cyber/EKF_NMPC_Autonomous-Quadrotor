<?xml version="1.0"?>
<sdf version="1.10">
  <model name="course_quadrotor">
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Gazebo uses ENU/FLU. The GNC stack performs an explicit conversion to NED/FRD. -->
    <link name="base_link">
      <inertial>
        <mass>1.20</mass>
        <inertia>
          <ixx>0.0125</ixx>
          <iyy>0.0125</iyy>
          <izz>0.0220</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box><size>0.16 0.12 0.06</size></box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box><size>0.16 0.12 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.12 0.18 1</ambient>
          <diffuse>0.12 0.35 0.65 1</diffuse>
        </material>
      </visual>

      <visual name="front_marker">
        <pose>0.10 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.03 0.025</size></box></geometry>
        <material>
          <ambient>0.8 0.1 0.05 1</ambient>
          <diffuse>0.9 0.15 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Arm endpoints use dx = dy = 0.225 m from the specification. -->
      <visual name="arm_x_visual">
        <geometry><box><size>0.50 0.025 0.018</size></box></geometry>
        <material><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>
      <visual name="arm_y_visual">
        <geometry><box><size>0.025 0.50 0.018</size></box></geometry>
        <material><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <visual name="rotor_0_visual">
        <pose>0.225 0.225 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.008</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 0.75</diffuse></material>
      </visual>
      <visual name="rotor_1_visual">
        <pose>-0.225 0.225 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.008</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 0.75</diffuse></material>
      </visual>
      <visual name="rotor_2_visual">
        <pose>-0.225 -0.225 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.008</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 0.75</diffuse></material>
      </visual>
      <visual name="rotor_3_visual">
        <pose>0.225 -0.225 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.08</radius><length>0.008</length></cylinder></geometry>
        <material><diffuse>0.75 0.75 0.78 0.75</diffuse></material>
      </visual>

      <!-- Raw ideal sensors. Required white noise and random-walk bias are added by
           sensor_simulator_node, keeping all course assumptions explicit in our code. -->
      <sensor name="imu_raw" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/drone/imu_raw</topic>
      </sensor>

      <sensor name="navsat_raw" type="navsat">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/drone/navsat_raw</topic>
      </sensor>
    </link>

    <!-- This is the team's own actuator map. It applies only the equations given
         in the specification; it does not call Gazebo's MulticopterMotorModel. -->
    <plugin filename="librotor_wrench_system.so"
            name="drone_gazebo::RotorWrenchSystem">
      <link_name>base_link</link_name>
      <command_topic>/drone/rotor_thrusts_gz</command_topic>
      <dx>0.225</dx>
      <dy>0.225</dy>
      <moment_ratio>0.015</moment_ratio>
      <min_thrust>0.2</min_thrust>
      <max_thrust>5.5</max_thrust>
      <command_timeout>0.2</command_timeout>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/model/course_quadrotor/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>

