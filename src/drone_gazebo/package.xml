  <version>0.1.0</version>
  <description>Gazebo Harmonic plant and independently implemented rotor wrench adapter.</description>
  <maintainer email="maintainer@example.com">MA6224 team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>drone_description</depend>
  <depend>drone_interfaces</depend>
  <depend>gz_msgs_vendor</depend>
